__pycache__/
*.pyc
*.egg-info/
dist/
.pytest_cache/
.venv/
.env
.DS_Store

# pre-baked MP3s never ship: the site engraves scores and synthesizes audio
# client-side, so the repo stores only symbolic files (manifests, MusicXML, MIDI)
data/*/audio/

# downloaded by scripts/setup_soundfont.sh
soundfonts/*.sf2
soundfonts/*.sf3
